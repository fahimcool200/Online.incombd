<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Trusted Income 360 BD</title>
    
    <!-- Telegram Web App Script -->
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --bg-gradient: linear-gradient(135deg, #05070a 0%, #1a1f35 100%);
            --primary: #00f3ff;
            --secondary: #7000ff;
            --text-main: #ffffff;
            --danger: #ff2a6d;
            --font-main: 'Poppins', sans-serif;
        }

        * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; user-select: none; }
        body {
            margin: 0; padding: 0; width: 100vw; height: 100vh;
            background: var(--bg-gradient); font-family: var(--font-main);
            color: var(--text-main); overflow: hidden;
            display: flex; flex-direction: column; align-items: center;
        }

        /* User Info Bar */
        .user-bar {
            width: 100%; padding: 10px; background: rgba(0,0,0,0.3);
            text-align: center; font-size: 12px; color: var(--primary);
            position: absolute; top: 0; left: 0; z-index: 20;
        }

        /* Header */
        .app-header { width: 100%; padding: 50px 20px 10px; display: flex; justify-content: center; z-index: 10; }
        .tg-btn {
            background: rgba(255, 255, 255, 0.1); border: 1px solid var(--primary);
            color: var(--primary); padding: 10px 25px; border-radius: 50px;
            text-decoration: none; font-weight: 600; font-size: 14px;
            display: flex; align-items: center; gap: 10px; backdrop-filter: blur(5px);
        }

        /* Wheel */
        .game-container { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; width: 100%; }
        
        .wheel-wrapper {
            position: relative; width: 320px; height: 320px; border-radius: 50%; padding: 10px;
            background: conic-gradient(from 0deg, var(--secondary), var(--primary), var(--secondary));
            box-shadow: 0 0 50px rgba(0, 243, 255, 0.15);
        }

        .wheel-inner { width: 100%; height: 100%; border-radius: 50%; background: #000; position: relative; overflow: hidden; border: 5px solid #000; }
        canvas { display: block; width: 100%; height: 100%; }

        .marker {
            position: absolute; top: -20px; left: 50%; transform: translateX(-50%);
            width: 40px; height: 50px; z-index: 5; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));
        }
        .marker::before {
            content: ''; position: absolute; left: 50%; transform: translateX(-50%);
            border-left: 15px solid transparent; border-right: 15px solid transparent; border-top: 35px solid #fff;
        }

        /* Controls */
        .controls-area { width: 100%; padding: 30px; display: flex; justify-content: center; z-index: 10; position: relative;}
        .spin-btn {
            background: var(--primary); color: #000; border: none; width: 100%; max-width: 300px;
            padding: 18px; font-family: var(--font-main); font-size: 20px; font-weight: 800;
            text-transform: uppercase; border-radius: 12px; cursor: pointer;
            box-shadow: 0 0 20px rgba(0, 243, 255, 0.2); transition: transform 0.1s;
        }
        .spin-btn:active { transform: scale(0.96); }
        .spin-btn:disabled { background: #333; color: #666; box-shadow: none; cursor: not-allowed; }

        .timer-text { position: absolute; bottom: 85px; font-size: 14px; color: var(--danger); font-weight: 600; display: none; }

        /* Admin Trigger */
        .admin-trigger { position: fixed; bottom: 10px; right: 10px; opacity: 0.3; font-size: 20px; cursor: pointer; z-index: 100; }

        /* Modals */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0, 0, 0, 0.9); backdrop-filter: blur(5px);
            display: none; align-items: center; justify-content: center; z-index: 200;
        }
        .modal-overlay.active { display: flex; }

        .modal-content {
            background: #151a27; border: 2px solid var(--primary); width: 90%; max-width: 350px;
            padding: 25px; border-radius: 15px; text-align: center; color: #fff;
            max-height: 90vh; overflow-y: auto;
        }
        
        input, textarea { width: 100%; padding: 10px; margin: 5px 0 15px; background: #05070a; border: 1px solid #333; color: #fff; border-radius: 5px; }
        
        .modal-btn { background: var(--primary); color: #000; border: none; padding: 10px 20px; border-radius: 5px; font-weight: bold; cursor: pointer; margin-top: 10px; width: 100%; }
        .modal-btn.close { background: #333; color: #fff; margin-top: 5px; }
    </style>
</head>
<body>

    <!-- User Info Display -->
    <div id="userInfo" class="user-bar">Logging in...</div>

    <div class="app-header">
        <a href="#" id="tg-link-btn" class="tg-btn" target="_blank">
            <i class="fab fa-telegram-plane"></i> Join Channel
        </a>
    </div>

    <div class="game-container">
        <div class="wheel-wrapper">
            <div class="marker"></div>
            <div class="wheel-inner">
                <canvas id="wheelCanvas" width="600" height="600"></canvas>
            </div>
        </div>
    </div>

    <div class="controls-area">
        <div id="timerDisplay" class="timer-text">Next Spin: 24h 00m</div>
        <!-- Fixed: Added onclick event directly -->
        <button id="spinBtn" class="spin-btn" onclick="spin()">SPIN TO WIN</button>
    </div>

    <!-- Admin Trigger Icon -->
    <div class="admin-trigger" onclick="openAdminLogin()">⚙️</div>

    <!-- Result Modal -->
    <div id="resultModal" class="modal-overlay">
        <div class="modal-content">
            <h1 id="resIcon" style="font-size: 50px; margin: 0;">🎉</h1>
            <h2 id="resTitle">Winner!</h2>
            <p id="resText">You won!</p>
            <button class="modal-btn" onclick="closeResultModal()">OK</button>
        </div>
    </div>

    <!-- Admin Login -->
    <div id="adminLoginModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Admin Login</h3>
            <input type="password" id="adminPass" placeholder="Enter Password">
            <button class="modal-btn" onclick="checkAdminPass()">Login</button>
            <button class="modal-btn close" onclick="document.getElementById('adminLoginModal').classList.remove('active')">Cancel</button>
        </div>
    </div>

    <!-- Admin Panel -->
    <div id="adminPanelModal" class="modal-overlay">
        <div class="modal-content" style="text-align: left;">
            <h3 style="text-align: center; margin-top:0;">Admin Panel</h3>
            
            <p style="text-align:center; font-size:12px; color:#aaa;">Global Winners: <span id="admTotalWins">0</span> / 10</p>
            <hr style="border-color: #333">

            <label>Prize Text</label>
            <input type="text" id="cfgPrize">

            <label>Telegram Link</label>
            <input type="text" id="cfgLink">

            <label>Win Chance (0.5 = 50%)</label>
            <input type="number" step="0.05" id="cfgChance">
            
            <label>Bot Token</label>
            <input type="text" id="cfgBotToken">
            
            <label>Chat ID</label>
            <input type="text" id="cfgChatID">

            <button class="modal-btn" style="background: #444; color: #fff;" onclick="resetMyCooldown()">Reset My Timer (Test)</button>

            <label style="display:block; margin-top:10px;">Full Config JSON</label>
            <textarea id="jsonArea" rows="3"></textarea>
            <button class="modal-btn" style="background: var(--secondary); color:#fff" onclick="importJson()">Import JSON</button>

            <button class="modal-btn" onclick="saveAdminSettings()">SAVE SETTINGS</button>
            <button class="modal-btn close" onclick="document.getElementById('adminPanelModal').classList.remove('active')">Close</button>
        </div>
    </div>

    <script>
        // ================= TELEGRAM USER DATA =================
        let currentUser = {
            id: "Unknown",
            username: "Guest",
            first_name: "Guest"
        };

        const tg = window.Telegram.WebApp;
        tg.expand(); 

        if (tg.initDataUnsafe && tg.initDataUnsafe.user) {
            currentUser = tg.initDataUnsafe.user;
            document.getElementById('userInfo').innerText = `Logged in as: ${currentUser.first_name} (@${currentUser.username || 'NoUsername'})`;
        } else {
            document.getElementById('userInfo').innerText = "Running outside Telegram (Guest Mode)";
        }

        // ================= CONFIG & STATE =================
        const DEFAULT_CONFIG = {
            prizeText: "0.05 USDT",
            telegramLink: "https://t.me/TrustedIncome360BD",
            winChance: 0.3,
            maxWinners: 10,
            botToken: "8268506010:AAHNsIBpPWzbK37cb5g8x8_1IXf1vHem6DM", 
            adminChatId: "5223267506",
            globalWinCount: 0 
        };
        const ADMIN_PASS = "SA20052@";

        let config = JSON.parse(localStorage.getItem('spin_config')) || DEFAULT_CONFIG;
        let lastSpinTime = parseInt(localStorage.getItem('spin_last_time')) || 0;
        const COOLDOWN_MS = 24 * 60 * 60 * 1000; 

        // ================= ENGINE =================
        const canvas = document.getElementById('wheelCanvas');
        const ctx = canvas.getContext('2d');
        const spinBtn = document.getElementById('spinBtn');
        const timerDisplay = document.getElementById('timerDisplay');
        const tgLinkBtn = document.getElementById('tg-link-btn');
        
        tgLinkBtn.href = config.telegramLink;

        const slices = 8;
        const radius = canvas.width / 2;
        const arc = (2 * Math.PI) / slices;
        let ang = 0;
        let isSpinning = false;

        function drawWheel() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for(let i=0; i<slices; i++) {
                const angStart = ang + (i * arc);
                const angEnd = ang + ((i + 1) * arc);
                const isWinSlice = (i % 2 === 0); 
                
                ctx.beginPath();
                ctx.moveTo(radius, radius);
                ctx.arc(radius, radius, radius, angStart, angEnd);
                ctx.fillStyle = isWinSlice ? '#00f3ff' : '#1e2538';
                ctx.fill();
                ctx.stroke();
                
                ctx.save();
                ctx.translate(radius, radius);
                ctx.rotate(angStart + arc / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = isWinSlice ? '#000' : '#fff';
                ctx.font = "bold 24px Poppins";
                const label = isWinSlice ? config.prizeText : "Try Again";
                ctx.fillText(label, radius - 20, 10);
                ctx.restore();
            }
        }

        // ================= GAME LOGIC =================
        function checkStatus() {
            const now = Date.now();
            
            // Limit Check
            if (config.globalWinCount >= config.maxWinners) {
                disableGame("Giveaway Ended", "Limit Reached");
                return;
            }

            // Cooldown Check
            if (now - lastSpinTime < COOLDOWN_MS) {
                const remaining = COOLDOWN_MS - (now - lastSpinTime);
                const hrs = Math.floor(remaining / (1000 * 60 * 60));
                const mins = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
                
                spinBtn.disabled = true;
                spinBtn.innerText = "COME BACK LATER";
                timerDisplay.style.display = 'block';
                timerDisplay.innerText = `Next Spin: ${hrs}h ${mins}m`;
            } else {
                spinBtn.disabled = false;
                spinBtn.innerText = "SPIN TO WIN";
                timerDisplay.style.display = 'none';
            }
            drawWheel();
        }

        function disableGame(btnText, alertText) {
            spinBtn.disabled = true;
            spinBtn.innerText = btnText;
            spinBtn.style.background = "#333";
        }

        function spin() {
            if (isSpinning) return;
            isSpinning = true;
            spinBtn.disabled = true;

            // Logic
            let isWin = Math.random() < config.winChance;
            if (config.globalWinCount >= config.maxWinners) isWin = false;

            // Target Index
            let targetIndex;
            if(isWin) {
                const possible = [0, 2, 4, 6];
                targetIndex = possible[Math.floor(Math.random() * possible.length)];
            } else {
                const possible = [1, 3, 5, 7];
                targetIndex = possible[Math.floor(Math.random() * possible.length)];
            }

            // Calc Angles
            const sliceDeg = 360 / slices;
            const stopAngle = -(targetIndex * sliceDeg) - (sliceDeg / 2) - 90; 
            const totalRot = (360 * 6) + stopAngle; 

            let start = null;
            const duration = 4000;
            const startAng = ang * 180 / Math.PI;

            function animate(time) {
                if (!start) start = time;
                const progress = Math.min((time - start) / duration, 1);
                const ease = 1 - Math.pow(1 - progress, 3);
                
                ang = (startAng + (totalRot - startAng) * ease) * Math.PI / 180;
                drawWheel();

                if (progress < 1) requestAnimationFrame(animate);
                else endSpin(isWin);
            }
            requestAnimationFrame(animate);
        }

        function endSpin(isWin) {
            isSpinning = false;
            lastSpinTime = Date.now();
            localStorage.setItem('spin_last_time', lastSpinTime);
            
            if (isWin) {
                config.globalWinCount++;
                localStorage.setItem('spin_config', JSON.stringify(config));
                
                document.getElementById('resIcon').innerText = "🎉";
                document.getElementById('resTitle').innerText = "CONGRATULATIONS!";
                document.getElementById('resTitle').style.color = "#00f3ff";
                document.getElementById('resText').innerText = `You won ${config.prizeText}! Screenshot this!`;
                
                sendTelegramAlert(config.prizeText);
            } else {
                document.getElementById('resIcon').innerText = "😢";
                document.getElementById('resTitle').innerText = "Try Again";
                document.getElementById('resTitle').style.color = "#ff2a6d";
                document.getElementById('resText').innerText = "Better luck next time!";
            }
            
            document.getElementById('resultModal').classList.add('active');
            checkStatus();
        }

        function closeResultModal() {
            document.getElementById('resultModal').classList.remove('active');
        }

        function sendTelegramAlert(prize) {
            if (!config.botToken || !config.adminChatId) return;
            const userLink = currentUser.username ? `@${currentUser.username}` : `[${currentUser.first_name}](tg://user?id=${currentUser.id})`;
            const msg = `🎰 *NEW WINNER!* 🎰\n\n👤 *User:* ${currentUser.first_name}\n🆔 *UID:* \`${currentUser.id}\`\n🔗 *Username:* ${userLink}\n\n🏆 *Prize:* ${prize}\n📊 *Total Winners:* ${config.globalWinCount}`;
            const url = `https://api.telegram.org/bot${config.botToken}/sendMessage?chat_id=${config.adminChatId}&text=${encodeURIComponent(msg)}&parse_mode=Markdown`;
            fetch(url).catch(err => console.log("Offline"));
        }

        function openAdminLogin() { document.getElementById('adminLoginModal').classList.add('active'); }

        function checkAdminPass() {
            const pass = document.getElementById('adminPass').value;
            if (pass === ADMIN_PASS) {
                document.getElementById('adminLoginModal').classList.remove('active');
                openAdminPanel();
            } else {
                alert('Wrong Password!');
            }
        }

        function openAdminPanel() {
            document.getElementById('adminPanelModal').classList.add('active');
            document.getElementById('cfgPrize').value = config.prizeText;
            document.getElementById('cfgLink').value = config.telegramLink;
            document.getElementById('cfgChance').value = config.winChance;
            document.getElementById('cfgBotToken').value = config.botToken;
            document.getElementById('cfgChatID').value = config.adminChatId;
            document.getElementById('admTotalWins').innerText = config.globalWinCount;
            document.getElementById('jsonArea').value = JSON.stringify(config, null, 2);
        }

        function saveAdminSettings() {
            config.prizeText = document.getElementById('cfgPrize').value;
            config.telegramLink = document.getElementById('cfgLink').value;
            config.winChance = parseFloat(document.getElementById('cfgChance').value);
            config.botToken = document.getElementById('cfgBotToken').value;
            config.adminChatId = document.getElementById('cfgChatID').value;
            localStorage.setItem('spin_config', JSON.stringify(config));
            tgLinkBtn.href = config.telegramLink;
            location.reload();
        }

        function importJson() {
            try {
                config = JSON.parse(document.getElementById('jsonArea').value);
                localStorage.setItem('spin_config', JSON.stringify(config));
                alert("Imported!");
                location.reload();
            } catch (e) { alert("Invalid JSON"); }
        }

        function resetMyCooldown() {
            localStorage.removeItem('spin_last_time');
            alert("Timer Reset!");
            checkStatus();
        }

        // Make sure button is connected in JS too
        document.getElementById('spinBtn').addEventListener('click', spin);

        // Init
        checkStatus();
    </script>
</body>
</html>